# Copy this file to terraform.tfvars and fill in your own values.
# terraform.tfvars is gitignored - never commit it.

aws_region   = "eu-west-2"
name_prefix  = "workshop-shop"
cluster_name = "workshop-shop-eks"

# The APPLICATION repository (aws-eks-terraform-argocd-shop-app), not the platform repository.
github_repository_owner  = "your-github-username-or-org"
github_repository_name   = "aws-eks-terraform-argocd-shop-app"
github_repository_branch = "main"

# Leave empty unless this AWS account already has a GitHub Actions OIDC
# provider (token.actions.githubusercontent.com) from another project.
existing_github_oidc_provider_arn = ""

# IAM principal (user or role) for whoever runs kubectl during the workshop.
operator_principal_arn = "arn:aws:iam::123456789012:user/your-iam-user"

# Your IP address in CIDR form, e.g. 203.0.113.4/32. Find it with:
#   curl -s https://checkip.amazonaws.com
admin_cidr = "203.0.113.4/32"
